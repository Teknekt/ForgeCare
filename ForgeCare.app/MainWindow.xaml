<Window x:Class="ForgeCare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ForgeCare.App.Converters"
        Title="ForgeCare — Technician Edition"
        Width="1320"
        Height="900"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0C0D0F"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>

        <converters:SeverityBrushConverter
            x:Key="SeverityBrushConverter"/>

        <!-- SPRINT 18 — FINAL VISUAL SYSTEM -->
        <LinearGradientBrush x:Key="ForgeAccentBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#F4D58A"
                          Offset="0"/>
            <GradientStop Color="#C7A65B"
                          Offset="0.52"/>
            <GradientStop Color="#8B6430"
                          Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ForgeSurfaceBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#181B1F"
                          Offset="0"/>
            <GradientStop Color="#121417"
                          Offset="0.58"/>
            <GradientStop Color="#0F1114"
                          Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ForgeHealthRingBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFE5A6"
                          Offset="0"/>
            <GradientStop Color="#C7A65B"
                          Offset="0.5"/>
            <GradientStop Color="#6F5128"
                          Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ForgeMutedBorderBrush"
                         Color="#2A2F35"/>

        <Style x:Key="HeroLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#C7A65B"/>
            <Setter Property="FontSize"
                    Value="9"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
</Style>

        <!-- ===================================================== -->
        <!-- CARDS                                                 -->
        <!-- ===================================================== -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource ForgeSurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ForgeMutedBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="5"
                                      Opacity="0.24"/>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- TABLE HEADERS                                         -->
        <!-- ===================================================== -->

        <Style x:Key="TableHeaderStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#747C85"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <!-- ===================================================== -->
        <!-- NAVIGATION                                            -->
        <!-- ===================================================== -->

        <Style x:Key="NavTabStyle"
               TargetType="TabItem">

            <Setter Property="Foreground"
                    Value="#7C848E"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="22,12"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border Background="Transparent"
                                Cursor="Hand">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="3"/>
                                </Grid.RowDefinitions>

                                <ContentPresenter Grid.Row="0"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>

                                <Border x:Name="ActiveLine"
                                        Grid.Row="1"
                                        Height="3"
                                        Background="Transparent"
                                        CornerRadius="2"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Foreground"
                                        Value="#E2C476"/>

                                <Setter TargetName="ActiveLine"
                                        Property="Background"
                                        Value="{StaticResource ForgeAccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- 9C POLISH -->
        <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777F88"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1D21"/>
            <Setter Property="Foreground" Value="#C8CDD2"/>
            <Setter Property="BorderBrush" Value="#34383D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#211719"/>
            <Setter Property="Foreground" Value="#E48B8B"/>
            <Setter Property="BorderBrush" Value="#553035"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="32,28,32,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="MINDFORGE STUDIO"
                           Foreground="#C7A65B"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <Border Width="86"
                        Height="3"
                        HorizontalAlignment="Left"
                        Background="{StaticResource ForgeAccentBrush}"
                        CornerRadius="2"
                        Margin="0,8,0,8"/>

                <TextBlock Text="FORGECARE"
                           FontSize="38"
                           FontWeight="Bold">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#FFFFFF"
                                          Offset="0"/>
                            <GradientStop Color="#F1E4C2"
                                          Offset="0.55"/>
                            <GradientStop Color="#C7A65B"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="Know your system. Forge it better."
                           Foreground="#889099"
                           FontSize="14"/>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock Text="VIEW" Foreground="#555D66" FontSize="8"/>
                    <TextBlock x:Name="CurrentViewTitleText"
                               Text="DASHBOARD"
                               Foreground="#C7A65B"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="7,0,0,0"/>
                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="TECHNICIAN EDITION"
                           Foreground="#8A9199"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>

                <Button Content="COMMANDS  Ctrl+K"
                        Width="145"
                        Height="30"
                        Margin="0,0,0,8"
                        Background="#15191D"
                        Foreground="#9AA2AB"
                        BorderBrush="#30353B"
                        BorderThickness="1"
                        FontSize="9"
                        HorizontalAlignment="Right"
                        Click="OpenCommandPaletteButton_Click"/>

                <TextBlock x:Name="HeaderVersionText"
                           Text="v1.0.0"
                           Foreground="#5D646D"
                           FontSize="11"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Right"/>

                <Border Background="#182119"
                        BorderBrush="#31523E"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        Margin="0,7,0,0"
                        HorizontalAlignment="Right">
                    <TextBlock Text="V1.0 RELEASE"
                               Foreground="#6EBE8C"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </Border>

            </StackPanel>

        </Grid>

        <!-- ===================================================== -->
        <!-- FORGE SHELL                                           -->
        <!-- ===================================================== -->


        <!-- PERSISTENT FORGE WORKFLOW BAR -->
        <Border Grid.Row="1"
                BorderBrush="#343029"
                BorderThickness="0,1,0,1"
                Padding="24,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">
                    <GradientStop Color="#131518"
                                  Offset="0"/>
                    <GradientStop Color="#191714"
                                  Offset="0.48"/>
                    <GradientStop Color="#111316"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE FORGE SESSION" Foreground="#777F88" FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PersistentWorkflowStageText" Text="READY" Foreground="#C7A65B"
                               FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="PersistentWorkflowStripText"
                               Text="○ SCAN   ○ ANALYZE   ○ PLAN   ○ FORGE   ○ VERIFY   ○ REPORT"
                               Foreground="#8C949D" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PersistentWorkflowCurrentText" Text="Start a Forge session"
                               Foreground="White" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="PROGRESS" Foreground="#777F88" FontSize="8"/>
                        <TextBlock x:Name="PersistentWorkflowProgressText" Text="0%" Foreground="#C7A65B"
                                   FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="PersistentWorkflowProgressBar" Height="5" Minimum="0" Maximum="100"
                                 Value="0" Margin="0,7,0,0" Foreground="#C7A65B" Background="#292D32"/>
                </StackPanel>
                <Button x:Name="PersistentContinueButton" Grid.Column="6" Content="CONTINUE →" Height="38"
                        Background="{StaticResource ForgeAccentBrush}" Foreground="#101010" BorderThickness="0" FontWeight="Bold"
                        IsEnabled="False" Click="PersistentContinueButton_Click"/>
                <Button Grid.Column="8" Content="WORKFLOW" Height="38" Background="#1A1D21"
                        Foreground="#8C949D" BorderBrush="#34383D" BorderThickness="1"
                        FontWeight="SemiBold" Click="OpenWorkflowButton_Click"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="20,0,20,20"
                    TabStripPlacement="Top">

            <TabControl.Template>

                <ControlTemplate TargetType="TabControl">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Background="#101215"
                                  Margin="12,0,12,0"
                                  HorizontalAlignment="Left"/>

                        <Border Grid.Row="1"
                                Height="1"
                                Background="#22262B"/>

                        <ContentPresenter Grid.Row="2"
                                          ContentSource="SelectedContent"/>

                    </Grid>

                </ControlTemplate>

            </TabControl.Template>

            <!-- ================================================= -->
            <!-- DASHBOARD                                         -->
            <!-- ================================================= -->

            <TabItem Header="DASHBOARD"
                     Style="{StaticResource NavTabStyle}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="12,24,12,24">

                        <!-- TOP -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- HEALTH -->

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Padding="28">

                                <StackPanel>

                                    <TextBlock Text="SYSTEM HEALTH"
                                               Foreground="#8C949D"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <Border Width="205"
                                            Height="205"
                                            Margin="0,24,0,22"
                                            CornerRadius="103"
                                            BorderThickness="7"
                                            BorderBrush="{StaticResource ForgeHealthRingBrush}"
                                            Background="#101317">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#C7A65B"
                                                              BlurRadius="26"
                                                              ShadowDepth="0"
                                                              Opacity="0.22"/>
                                        </Border.Effect>

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock x:Name="HealthScoreText"
                                                       Text="--"
                                                       Foreground="White"
                                                       FontSize="66"
                                                       FontWeight="Light"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock x:Name="HealthRatingText"
                                                       Text="NOT SCANNED"
                                                       Foreground="#889099"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                    <Button x:Name="ScanButton"
                                            Height="52"
                                            Content="RUN SYSTEM SCAN"
                                            Background="{StaticResource ForgeAccentBrush}"
                                            Foreground="#101010"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="ScanButton_Click"/>

                                    <TextBlock x:Name="ScanStatusText"
                                               Text="Forge ready."
                                               Margin="0,16,0,0"
                                               Foreground="#747C85"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                            <!-- RIGHT -->

                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- STATUS -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- STORAGE -->

                                    <Border Grid.Column="0"
                                            Style="{StaticResource CardStyle}"
                                            Padding="18">

                                        <StackPanel>

                                            <TextBlock Text="STORAGE"
                                                       Foreground="#777F88"
                                                       FontSize="11"/>

                                            <TextBlock x:Name="StorageStatusText"
                                                       Text="Awaiting scan"
                                                       Foreground="White"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Margin="0,7,0,0"/>

                                            <TextBlock x:Name="StorageDetailText"
                                                       Text="—"
                                                       Foreground="#C7A65B"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- MEMORY -->

                                    <Border Grid.Column="2"
                                            Style="{StaticResource CardStyle}"
                                            Padding="18">

                                        <StackPanel>

                                            <TextBlock Text="MEMORY"
                                                       Foreground="#777F88"
                                                       FontSize="11"/>

                                            <TextBlock x:Name="MemoryStatusText"
                                                       Text="Awaiting scan"
                                                       Foreground="White"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Margin="0,7,0,0"/>

                                            <TextBlock x:Name="MemoryDetailText"
                                                       Text="—"
                                                       Foreground="#C7A65B"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- STARTUP -->

                                    <Border Grid.Column="4"
                                            Style="{StaticResource CardStyle}"
                                            Padding="18">

                                        <StackPanel>

                                            <TextBlock Text="STARTUP"
                                                       Foreground="#777F88"
                                                       FontSize="11"/>

                                            <TextBlock x:Name="StartupStatusText"
                                                       Text="Awaiting scan"
                                                       Foreground="White"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Margin="0,7,0,0"/>

                                            <TextBlock x:Name="StartupDetailText"
                                                       Text="—"
                                                       Foreground="#C7A65B"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                                <!-- SYSTEM OVERVIEW -->

                                <Border Grid.Row="2"
                                        Style="{StaticResource CardStyle}"
                                        Padding="28">

                                    <StackPanel>

                                        <TextBlock Text="SYSTEM OVERVIEW"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                        <Separator Margin="0,18"
                                                   Background="#292D32"/>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock Text="DEVICE"
                                                           Foreground="#C7A65B"
                                                           FontSize="11"/>

                                                <TextBlock x:Name="ComputerNameText"
                                                           Text="—"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           Margin="0,4,0,16"/>

                                                <TextBlock Text="OPERATING SYSTEM"
                                                           Foreground="#C7A65B"
                                                           FontSize="11"/>

                                                <TextBlock x:Name="OperatingSystemText"
                                                           Text="—"
                                                           Foreground="White"
                                                           FontSize="15"
                                                           Margin="0,4,20,16"/>

                                                <TextBlock Text="PROCESSOR"
                                                           Foreground="#C7A65B"
                                                           FontSize="11"/>

                                                <TextBlock x:Name="ProcessorText"
                                                           Text="—"
                                                           Foreground="White"
                                                           FontSize="15"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,20,0"/>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1">

                                                <TextBlock Text="MEMORY"
                                                           Foreground="#C7A65B"
                                                           FontSize="11"/>

                                                <TextBlock x:Name="MemoryText"
                                                           Text="—"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           Margin="0,4,0,24"/>

                                                <TextBlock Text="SYSTEM DRIVE"
                                                           Foreground="#C7A65B"
                                                           FontSize="11"/>

                                                <TextBlock x:Name="StorageText"
                                                           Text="—"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>

                                        </Grid>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Grid>

                        <!-- SPRINT 12B — GUIDED TECHNICIAN UX -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/><ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="NEXT" Foreground="#777F88" FontSize="9"/>
                                        <TextBlock x:Name="GuidedActionStageText" Text="SCAN" Foreground="#C7A65B"
                                                   FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NEXT BEST ACTION" Foreground="#777F88" FontSize="9"/>
                                        <TextBlock x:Name="GuidedActionTitleText" Text="Capture system baseline"
                                                   Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="GuidedActionDetailText" Text="Run a System Scan to begin."
                                                   Foreground="#8C949D" FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                        <TextBlock x:Name="GuidedActionRouteText" Text="DASHBOARD" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="GuidedActionButton" Grid.Column="3" Content="RUN SYSTEM SCAN"
                                            Height="42" VerticalAlignment="Center" Background="{StaticResource ForgeAccentBrush}"
                                            Foreground="#101010" BorderThickness="0" FontWeight="Bold"
                                            Click="GuidedActionButton_Click"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="LAST RESULT" Foreground="#777F88" FontSize="9"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LastResultTitleText" Text="No completed service action yet"
                                                   Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LastResultMetricText" Grid.Column="1" Text="READY"
                                                   Foreground="#8C949D" FontSize="10" FontWeight="Bold" Margin="10,2,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="LastResultDetailText"
                                               Text="Run a System Scan to begin the technician result feed."
                                               Foreground="#8C949D" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="QUICK FORGE" Foreground="#C7A65B" FontSize="10" FontWeight="SemiBold"/>
                                    <Button Content="CONTINUE SAFE FLOW →" Height="38" Margin="0,8,0,0"
                                            Background="#1B1E22" Foreground="White" BorderBrush="#34383D"
                                            BorderThickness="1" FontWeight="SemiBold" Click="QuickForgeButton_Click"/>
                                    <Button Content="LOAD SAMPLE SESSION" Height="34" Margin="0,7,0,0" Visibility="Collapsed"
                                            Background="#181B1E" Foreground="#8C949D" BorderBrush="#30353B"
                                            BorderThickness="1" FontSize="9" Click="OpenDemoSessionButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- LOWER -->

                        <Grid Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- STARTUP LIST -->

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Padding="22"
                                    MinHeight="320">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="StartupListTitle"
                                                   Text="STARTUP ITEMS"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <Button Grid.Column="1"
                                                Content="VIEW ALL"
                                                Padding="12,5"
                                                Background="#1B1E22"
                                                Foreground="#8C949D"
                                                BorderBrush="#34383D"
                                                BorderThickness="1"/>

                                    </Grid>

                                    <Grid Grid.Row="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="NAME"
                                                   Style="{StaticResource TableHeaderStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="SOURCE"
                                                   Style="{StaticResource TableHeaderStyle}"/>

                                    </Grid>

                                    <ListView x:Name="StartupListView"
                                              Grid.Row="4"
                                              Height="180"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="White"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">


                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="ForgeCare re-verifies the staged installer before handoff. Installation requires an explicit confirmation and is launched through Windows Shell without silent switches. ForgeCare then closes so application files can be upgraded safely."
                                               Foreground="#7C848E"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,14"/>

                                    <Button x:Name="PrepareInstallerHandoffButton"
                                            Content="PREPARE VERIFIED INSTALL"
                                            Height="38"
                                            Background="#1B2025"
                                            Foreground="White"
                                            BorderBrush="#343B43"
                                            FontWeight="Bold"
                                            IsEnabled="False"
                                            Click="PrepareInstallerHandoffButton_Click"/>

                                    <CheckBox x:Name="ConfirmInstallerHandoffCheckBox"
                                              Content="I understand that Windows will launch the verified ForgeCare installer and ForgeCare will close."
                                              Foreground="#B9C0C8"
                                              FontSize="10"
                                              Margin="0,14,0,0"
                                              IsEnabled="False"
                                              Checked="ConfirmInstallerHandoffCheckBox_Checked"
                                              Unchecked="ConfirmInstallerHandoffCheckBox_Checked"/>

                                    <Button x:Name="LaunchVerifiedInstallerButton"
                                            Content="INSTALL VERIFIED UPDATE"
                                            Height="40"
                                            Margin="0,14,0,0"
                                            Background="{StaticResource ForgeAccentBrush}"
                                            Foreground="#101010"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            IsEnabled="False"
                                            Click="LaunchVerifiedInstallerButton_Click"/>

                                    <TextBlock x:Name="InstallerHandoffDetailText"
                                               Text="Download and verify a newer installer before preparing installation."
                                               Foreground="#7C848E"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            </TabItem>

        </TabControl>

        <Border x:Name="CommandPaletteBorder"
                Grid.Row="0"
                Grid.RowSpan="4"
                Background="#B8000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Grid>
                <Border Width="620"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#121518"
                        BorderBrush="#3A4047"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FORGECARE COMMANDS" Foreground="#C7A65B" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Jump directly to a technician workspace" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="ESC" Width="48" Height="30"
                                    Background="#191D21" Foreground="#7C848E" BorderBrush="#30353B"
                                    Click="CloseCommandPaletteButton_Click"/>
                        </Grid>

                        <TextBox x:Name="CommandPaletteSearchTextBox"
                                 Height="42"
                                 Margin="0,18,0,0"
                                 Padding="12,8"
                                 Background="#0E1114"
                                 Foreground="White"
                                 BorderBrush="#343A41"
                                 FontSize="12"
                                 TextChanged="CommandPaletteSearchTextBox_TextChanged"/>

                        <ListView x:Name="CommandPaletteListView"
                                  Height="360"
                                  Margin="0,12,0,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MouseDoubleClick="CommandPaletteListView_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101317" BorderBrush="#292E34"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Header}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#7C848E" FontSize="9"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Foreground="#C7A65B" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Double-click a destination · Esc closes"
                                   Foreground="#555D66" FontSize="8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- FORGECARE V1 — PRODUCT STATUS BAR -->
        <Border Grid.Row="3"
                Background="#0B0D0F"
                BorderBrush="#25292E"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FORGECARE v1.0"
                           Foreground="#6EBE8C"
                           FontSize="9"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ShellStatusText"
                           Grid.Column="2"
                           Text="Ready · technician safeguards active"
                           Foreground="#7C848E"
                           FontSize="9"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="Ctrl+K Commands · Ctrl+1 Dashboard · Ctrl+2 Analysis · Ctrl+3 Workflow · Ctrl+4 Reports · Ctrl+5 Tools · Ctrl+, Settings"
                           Foreground="#555D66"
                           FontSize="8"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>

</Window>

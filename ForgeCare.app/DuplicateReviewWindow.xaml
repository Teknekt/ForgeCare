<Window x:Class="ForgeCare.App.DuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeCare Duplicate Review"
        Width="1060"
        Height="850"
        MinWidth="940"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#0C0D0F">

    <Window.Resources>
        <Style x:Key="ReviewCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#141619"/>
            <Setter Property="BorderBrush"
                    Value="#292D32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MINDFORGE STUDIO"
                           Foreground="#C7A65B"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <TextBlock Text="EXACT DUPLICATE REVIEW"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,3,0,0"/>
                <TextBlock Text="SHA-256 confirmed copies. Select redundant copies only — ForgeCare will always require at least one copy to remain."
                           Foreground="#7C848E"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#211D12"
                    BorderBrush="#5E512D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadgeText"
                           Text="REVIEW MODE"
                           Foreground="#C7A65B"
                           FontSize="11"
                           FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource ReviewCard}"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="GROUPS"
                               Foreground="#747C85"
                               FontSize="10"/>
                    <TextBlock x:Name="GroupCountText"
                               Text="--"
                               Foreground="White"
                               FontSize="25"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource ReviewCard}"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="SELECTED COPIES"
                               Foreground="#747C85"
                               FontSize="10"/>
                    <TextBlock x:Name="SelectedCountText"
                               Text="0"
                               Foreground="#C7A65B"
                               FontSize="25"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource ReviewCard}"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="SELECTED DATA"
                               Foreground="#747C85"
                               FontSize="10"/>
                    <TextBlock x:Name="SelectedSizeText"
                               Text="0 B"
                               Foreground="White"
                               FontSize="25"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    Style="{StaticResource ReviewCard}"
                    Padding="15">
                <StackPanel>
                    <TextBlock x:Name="ResultLabelText"
                               Text="VALIDATED"
                               Foreground="#747C85"
                               FontSize="10"/>
                    <TextBlock x:Name="ResultValueText"
                               Text="--"
                               Foreground="#6EBE8C"
                               FontSize="25"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DUPLICATE COPIES"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Row="2"
                       Text="Nothing is preselected. If you select every copy in one duplicate group, dry run blocks that group so at least one copy is preserved."
                       Foreground="#747C85"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <ListView x:Name="DuplicateFileListView"
                      Grid.Row="4"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141619"
                                BorderBrush="#292D32"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,9"
                                Padding="13">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Click="DuplicateCheckBox_Click"/>

                                <Border Grid.Column="1"
                                        Width="4"
                                        Background="#5A96E6"
                                        CornerRadius="2"/>

                                <StackPanel Grid.Column="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GroupId}"
                                                   Foreground="#C7A65B"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Location}"
                                                   Foreground="#747C85"
                                                   FontSize="9"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding FullPath}"
                                               Foreground="#5E6670"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,12,0"/>

                                    <TextBlock Text="{Binding StatusReason}"
                                               Foreground="#8C949D"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Margin="0,3,12,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplaySize}"
                                               Foreground="White"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding DisplayLastWrite}"
                                               Foreground="#747C85"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#C7A65B"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="EXACT SHA-256 MATCH"
                                               Foreground="#6EBE8C"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Grid>

        <Border Grid.Row="6"
                Background="#111316"
                BorderBrush="#3B3422"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SafetyTitleText"
                               Text="EXACT-DUPLICATE SAFETY MODE"
                               Foreground="#C7A65B"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SafetyStatusText"
                               Text="Only user-selected copies can be recycled. ForgeCare refuses to recycle every copy in a duplicate group."
                               Foreground="#8C949D"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="CLOSE"
                            Height="48"
                            Background="#1A1D21"
                            Foreground="#A0A7AF"
                            BorderBrush="#34383D"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Click="CloseButton_Click"/>

                    <Button x:Name="SimulateButton"
                            Grid.Column="2"
                            Content="RUN DRY RUN"
                            Height="48"
                            Background="#25292E"
                            Foreground="White"
                            BorderBrush="#3A3F45"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Click="SimulateButton_Click"/>

                    <Button x:Name="ExecuteButton"
                            Grid.Column="4"
                            Content="RECYCLE DUPLICATES LOCKED"
                            Height="48"
                            Background="#25292E"
                            Foreground="#666C73"
                            BorderBrush="#34383D"
                            BorderThickness="1"
                            FontWeight="Bold"
                            IsEnabled="False"
                            Click="ExecuteButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

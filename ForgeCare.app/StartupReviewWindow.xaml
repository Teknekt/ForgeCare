<Window x:Class="ForgeCare.App.StartupReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeCare Startup Review"
        Width="980" Height="820"
        MinWidth="880" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#0C0D0F">

    <Window.Resources>
        <Style x:Key="ReviewCard" TargetType="Border">
            <Setter Property="Background" Value="#141619"/>
            <Setter Property="BorderBrush" Value="#292D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MINDFORGE STUDIO" Foreground="#C7A65B"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="STARTUP REVIEW" Foreground="White"
                           FontSize="28" FontWeight="Bold" Margin="0,3,0,0"/>
                <TextBlock Text="Select → dry run → confirm → disable → restore"
                           Foreground="#7C848E" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#211D12" BorderBrush="#5E512D"
                    BorderThickness="1" CornerRadius="8" Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadgeText" Text="REVIEW MODE"
                           Foreground="#C7A65B" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ReviewCard}" Padding="15">
                <StackPanel>
                    <TextBlock Text="AVAILABLE" Foreground="#747C85" FontSize="10"/>
                    <TextBlock x:Name="AvailableCountText" Text="--" Foreground="White" FontSize="25"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource ReviewCard}" Padding="15">
                <StackPanel>
                    <TextBlock Text="SELECTED" Foreground="#747C85" FontSize="10"/>
                    <TextBlock x:Name="SelectedCountText" Text="--" Foreground="#C7A65B" FontSize="25"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource ReviewCard}" Padding="15">
                <StackPanel>
                    <TextBlock Text="IMPACT SCORE" Foreground="#747C85" FontSize="10"/>
                    <TextBlock x:Name="SelectedImpactText" Text="--" Foreground="White" FontSize="25"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource ReviewCard}" Padding="15">
                <StackPanel>
                    <TextBlock Text="UNDO RECORDS" Foreground="#747C85" FontSize="10"/>
                    <TextBlock x:Name="UndoCountText" Text="--" Foreground="#6EBE8C" FontSize="25"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitleText" Text="STARTUP CANDIDATES"
                       Foreground="White" FontSize="16" FontWeight="SemiBold"/>

            <ListView x:Name="StartupChangeListView" Grid.Row="2"
                      Background="Transparent" BorderThickness="0" Foreground="White"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141619" BorderBrush="#292D32"
                                BorderThickness="1" CornerRadius="9"
                                Margin="0,0,0,9" Padding="13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Click="SelectionCheckBox_Click"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" Foreground="#C7A65B"
                                                   FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Recommendation}" Foreground="#8C949D"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Source}" Foreground="#6E7680"
                                               FontSize="10" Margin="0,3,12,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusReason}" Foreground="#8C949D"
                                               FontSize="10" Margin="0,3,12,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="#C7A65B"
                                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ImpactScore, StringFormat=IMPACT {0}}"
                                               Foreground="White" FontSize="14" HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Confidence, StringFormat=CONFIDENCE {0}}"
                                               Foreground="#5E6670" FontSize="9" HorizontalAlignment="Right"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="6" Background="#111316" BorderBrush="#3B3422"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SafetyTitleText" Text="SAFE STARTUP CHANGE ENGINE"
                               Foreground="#C7A65B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="SafetyStatusText"
                               Text="Only supported current-user entries can change. KEEP and machine-wide entries stay locked."
                               Foreground="#8C949D" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="CLOSE" Height="48" Background="#1A1D21" Foreground="#A0A7AF"
                            BorderBrush="#34383D" BorderThickness="1" FontWeight="SemiBold"
                            Click="CloseButton_Click"/>

                    <Button x:Name="RestoreButton" Grid.Column="2" Content="RESTORE ALL"
                            Height="48" Background="#1A1D21" Foreground="#6EBE8C"
                            BorderBrush="#365844" BorderThickness="1" FontWeight="SemiBold"
                            Click="RestoreButton_Click"/>

                    <Button x:Name="SimulateButton" Grid.Column="4" Content="RUN DRY RUN"
                            Height="48" Background="#25292E" Foreground="White"
                            BorderBrush="#3A3F45" BorderThickness="1" FontWeight="SemiBold"
                            Click="SimulateButton_Click"/>

                    <Button x:Name="ExecuteButton" Grid.Column="6" Content="LIVE DISABLE LOCKED"
                            Height="48" Background="#25292E" Foreground="#666C73"
                            BorderBrush="#34383D" BorderThickness="1" FontWeight="Bold"
                            IsEnabled="False" Click="ExecuteButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
